FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
WORKDIR /testbed

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git python3 python3-pip python3-dev python3-venv \
        build-essential pkg-config ca-certificates curl jq wget \
        libgl1-mesa-glx libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install torch CPU-only (pre-built wheel, ~800MB but no compilation)
RUN python3 -m pip install --break-system-packages \
    torch --index-url https://download.pytorch.org/whl/cpu

# Install MONAI and all its test deps
RUN python3 -m pip install --break-system-packages \
    "monai" \
    "numpy>=1.20" \
    "nibabel" \
    "pillow" \
    "scipy" \
    "itk" \
    "skimage" \
    "einops" \
    "pytest>=7" \
    "pytest-xdist" \
    "parameterized"

ENV PATH="/root/.local/bin:$PATH"
